    "email:test": "node --conditions=react-server --import tsx scripts/test-email.ts"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "^3.11.3",
    "cloudinary": "^2.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.3",
    "motion": "^13.2.0",
    "next": "16.3.2",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@serwist/cli": "^9.5.13",
    "@serwist/next": "^9.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "serwist": "^9.5.13",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
