MONGODB_URI=mongodb://127.0.0.1:27017/carxsailor
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Prefer GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET for new deployments; AUTH_GOOGLE_*
# remains supported for existing deployments. Register /api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public SEO identity. In production, keep all three application URLs at
# https://carxsailor.com (never a Vercel deployment or preview URL).
SITE_URL=http://localhost:3000
# Optional Search Console HTML verification token (content value only).
GOOGLE_SITE_VERIFICATION=

# Cloudinary server-side uploads (use CLOUDINARY_URL, or all three fields below)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Transactional email (server-only). Use your Resend account email for testing.
RESEND_API_KEY=
EMAIL_FROM="CarXSailor <onboarding@resend.dev>"
# Alternatively use EMAIL_FROM_NAME and EMAIL_FROM_ADDRESS for an existing verified sender.
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
ADMIN_NOTIFICATION_EMAIL=
# Better Auth email links reuse NEXT_PUBLIC_APP_URL above; keep BETTER_AUTH_URL in sync.
# With a verified sender, production automatically sends to the real user.

# Public customer-facing WhatsApp number, digits only (no +).
NEXT_PUBLIC_ADMIN_WHATSAPP_NUMBER=2349155276978
